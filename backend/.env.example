PORT=5000
# Database Connection: Local MongoDB or MongoDB Atlas
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/heritage_connect
# For MongoDB Atlas (replace <username>, <password>, and cluster domain):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/heritage_connect?retryWrites=true&w=majority

JWT_SECRET=heritage_connect_super_secret_jwt_key_2026_cse_project
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# -------------------------------------------------------------
# Live Email Verification Providers (configure at least ONE)
# -------------------------------------------------------------
# Option A: Resend (Recommended, free tier: 100 emails/day, no credit card required)
# Get your API key at: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=HeritageConnect <onboarding@resend.dev>

# Option B: Brevo (formerly Sendinblue, free tier: 300 emails/day)
# Get your API key at: https://brevo.com
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=verify@heritageconnect.org

# Option C: Standard SMTP (e.g., Gmail with App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
